# Copie ce fichier en .env et renseigne tes propres valeurs.
# Client ID : public, peut être exposé au navigateur (préfixe VITE_).
VITE_STRAVA_CLIENT_ID=

# Secret client : jamais exposé au navigateur, utilisé uniquement par les
# fonctions serverless (api/strava/*). Ne jamais le commiter.
STRAVA_CLIENT_SECRET=
